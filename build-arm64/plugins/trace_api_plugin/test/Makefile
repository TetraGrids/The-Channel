	cd /Users/fresh/Dropbox/htdocs/The-Channel/build-arm64 && $(CMAKE_COMMAND) -P /Users/fresh/Dropbox/htdocs/The-Channel/build-arm64/CMakeFiles/VerifyGlobs.cmake
